# Copy to .env for local development. On Render, set these as Environment Variables.

# Port (Render sets this automatically; default 3000 locally)
PORT=3000

# Secret used to sign session cookies. MUST be a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the site (used in verification emails). e.g. https://bid.keysgunshop.com
PUBLIC_BASE_URL=http://localhost:3000

# Email transport: "console" (dev — prints links to the server log) or "smtp"
EMAIL_TRANSPORT=console

# SMTP settings (only needed when EMAIL_TRANSPORT=smtp). Requires `npm i nodemailer`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Keys Gun Shop Auctions <auctions@keysgunshop.com>"

# First-run staff account (created automatically if no staff exist)
BOOTSTRAP_STAFF_EMAIL=owner@keysgunshop.com
BOOTSTRAP_STAFF_PASSWORD=change-me-now

# Persist the in-memory store to disk between restarts (dev convenience).
# In production use a real database instead (see README).
PERSIST_TO_DISK=true
